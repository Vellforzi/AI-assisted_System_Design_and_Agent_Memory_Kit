{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-memory-kit:project-artifact:v2:ExplorationMapV1",
  "title": "ExplorationMapV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "map_id", "task_id", "destination", "status", "decisions", "out_of_scope", "fog", "items", "frontier_assertion", "product_mutation_allowed", "owner_acceptance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "map_id": {"type": "string", "pattern": "^EXP-[A-Za-z0-9._-]+$"},
    "task_id": {"type": "string"},
    "destination": {"type": "string", "minLength": 1},
    "status": {"enum": ["open", "ready_for_delivery", "cancelled"]},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence_refs"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "fog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "state"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "state": {"enum": ["unresolved", "resolved", "out_of_scope"]}
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "question", "status", "blocked_by", "evidence_refs", "decision_ref"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["research", "prototype", "grilling", "owner_task"]},
          "question": {"type": "string"},
          "status": {"enum": ["open", "blocked", "active", "resolved", "cancelled"]},
          "blocked_by": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "decision_ref": {"type": ["string", "null"]}
        }
      }
    },
    "frontier_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_ids", "navigation_only"],
      "properties": {
        "item_ids": {"type": "array", "items": {"type": "string"}},
        "navigation_only": {"const": true}
      }
    },
    "product_mutation_allowed": {"const": false},
    "owner_acceptance": {"enum": ["pending", "accepted", "rejected"]}
  }
}
