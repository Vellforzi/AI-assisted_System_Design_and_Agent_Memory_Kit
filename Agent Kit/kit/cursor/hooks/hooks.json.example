{
  "note": "Illustrative Cursor hooks configuration. Verify the current Cursor hooks schema before use.",
  "policy": "Prefer fail-closed for secrets, DB writes, git danger, unauthorized Project Map writes, and out-of-scope changes.",
  "hooks": [
    {
      "name": "block-secrets",
      "event": "before_file_write_or_after_edit",
      "command": "python3 Agent Kit/kit/cursor/hooks/scripts/block_secrets.py --paths ."
    },
    {
      "name": "block-db-writes",
      "event": "before_command",
      "command": "python3 Agent Kit/kit/cursor/hooks/scripts/block_db_writes.py --command \"${COMMAND}\""
    },
    {
      "name": "block-git-danger",
      "event": "before_command",
      "command": "python3 Agent Kit/kit/cursor/hooks/scripts/block_git_danger.py --command \"${COMMAND}\""
    },
    {
      "name": "scope-guard",
      "event": "before_file_write_or_after_edit",
      "command": "python3 Agent Kit/kit/cursor/hooks/scripts/scope_guard.py --allowed-from-env AGENT_MEMORY_ALLOWED_PATHS --changed-from-env AGENT_MEMORY_CHANGED_PATHS"
    },
    {
      "name": "project-map-write-guard",
      "event": "before_file_write_or_after_edit",
      "command": "python3 Agent Kit/kit/cursor/hooks/scripts/project_map_write_guard.py --changed-from-env AGENT_MEMORY_CHANGED_PATHS"
    }
  ]
}
