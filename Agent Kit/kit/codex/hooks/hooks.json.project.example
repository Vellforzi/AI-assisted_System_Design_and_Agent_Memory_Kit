{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_compact_checkpoint_guard.py\"",
            "commandWindows": "py -3 .codex\\hooks\\pre_compact_checkpoint_guard.py",
            "timeout": 30,
            "statusMessage": "Checking checkpoint before compaction"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/user_prompt_scope_guard.py\"",
            "commandWindows": "py -3 .codex\\hooks\\user_prompt_scope_guard.py",
            "timeout": 30,
            "statusMessage": "Checking action intent and scope"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/dangerous_command_guard.py\"",
            "commandWindows": "py -3 .codex\\hooks\\dangerous_command_guard.py",
            "timeout": 30,
            "statusMessage": "Checking dangerous commands"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/project_map_write_guard.py\"",
            "commandWindows": "py -3 .codex\\hooks\\project_map_write_guard.py",
            "timeout": 30,
            "statusMessage": "Checking Project Map writes"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/secret_guard.py\"",
            "commandWindows": "py -3 .codex\\hooks\\secret_guard.py",
            "timeout": 30,
            "statusMessage": "Checking secret access"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/post_compact_recover_notice.py\"",
            "commandWindows": "py -3 .codex\\hooks\\post_compact_recover_notice.py",
            "timeout": 30,
            "statusMessage": "Forcing recovery after compaction"
          }
        ]
      }
    ]
  }
}
