{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-memory-kit:project-artifact:v1:SideEffectReceiptV1",
  "title": "SideEffectReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "task_id", "action_id", "idempotency_key", "status", "target", "evidence_refs", "safe_to_repeat"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "pattern": "^SE-[A-Za-z0-9._-]+$"},
    "task_id": {"type": "string"},
    "action_id": {"type": "string"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed", "ambiguous", "void"]},
    "target": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "safe_to_repeat": {"type": "boolean"}
  }
}
