{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-memory-kit:project-artifact:v1:VerificationReceiptV1",
  "title": "VerificationReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "task_id", "claim_ids", "verifier_type", "status", "evidence_refs", "verified_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "pattern": "^VR-[A-Za-z0-9._-]+$"},
    "task_id": {"type": "string"},
    "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verifier_type": {"enum": ["project_test", "tool_output", "external_source", "owner", "human_oracle"]},
    "status": {"enum": ["passed", "failed", "inconclusive", "unsupported"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "verified_at": {"type": "string", "minLength": 1}
  }
}
