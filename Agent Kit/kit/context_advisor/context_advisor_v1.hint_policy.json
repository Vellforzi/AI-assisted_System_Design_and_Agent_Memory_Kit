{
  "version": "1.0.3",
  "defaultHintMode": "silent",
  "autoCompactTriggers": [
    "sufficiency_gate_amber_red_or_blocked",
    "apply_audit_repair_recover_or_cross_subsystem_debug_task",
    "missing_mandatory_context",
    "overbroad_scope_detected",
    "model_or_surface_requested",
    "provider_capability_snapshot_stale_or_missing",
    "max_mode_or_ide_context_likely_wrong",
    "implicit_ide_context_present_without_explicit_scope",
    "implicit_ide_context_used_for_scope_expansion",
    "premium_model_or_high_reasoning_without_escalation_reason",
    "model_cost_class_requested",
    "cheaper_alternative_missing_for_premium_route",
    "provider_model_snapshot_missing_or_stale",
    "unsupported_model_control_requested",
    "context_window_1m_without_context_need",
    "model_added_without_project_benchmark_or_failure_case",
    "dated_provider_snapshot_missing_for_exact_model_advice",
    "core_model_set_expansion_requested",
    "optional_model_without_capability_gap",
    "fast_mode_without_time_pressure",
    "large_context_without_scope_need",
    "model_controls_requested"
  ],
  "expandedHintTriggers": [
    "settings?",
    "scope?",
    "fuel?",
    "why?",
    "safe apply?",
    "which model",
    "what to enable",
    "where to run",
    "какую модель",
    "что включить",
    "почему",
    "где запускать",
    "cheaper model",
    "why not cheaper",
    "cost class",
    "экономнее",
    "дешевле",
    "почему не дешевле",
    "models?",
    "model matrix",
    "provider snapshot",
    "routing matrix",
    "какие модели",
    "матрица моделей",
    "снимок моделей",
    "model snapshot",
    "snapshot date",
    "обновить модельный снапшот",
    "какой режим",
    "какие модели добавить",
    "достаточно моделей"
  ],
  "blockingTriggers": [
    "secrets_requested_or_detected",
    "db_write_without_owner_ok",
    "deploy_without_owner_ok",
    "project_map_write_without_owner_ask",
    "product_code_edit_without_required_gate",
    "duplicate_side_effect_risk",
    "branch_lineage_ambiguous_for_mutation",
    "implicit_ide_context_used_for_write_scope_without_owner_approval"
  ],
  "compactHintMaxLines": 5,
  "compactHintFields": [
    "gate",
    "missing_context",
    "surface",
    "model_settings",
    "next_action"
  ],
  "doNotShowByDefault": [
    "full_profile_matrix",
    "raw_decision_trace",
    "provider_pricing_details",
    "large_context_inventory"
  ],
  "redactionRules": [
    "never include secrets in user-visible hints",
    "do not quote access files",
    "show refs, not payloads",
    "show stale facts only as stale/repair/audit/recover context",
    "implicit IDE context is advisory only unless explicitly scoped or owner-approved",
    "premium/high/pro recommendation must include an escalation trigger and cheaper alternative",
    "do not recommend the strongest model as a generic safety default",
    "provider/model snapshot must include collected_at date and source refs",
    "do not invent unsupported model controls; Composer 2.5 has only Fast on/off in the owner-observed Cursor UI snapshot",
    "do not add more models to the router unless the current working set fails a concrete task class or the owner explicitly requests a benchmark",
    "exact model/settings advice must show provider snapshot date or say snapshot is missing",
    "core model set should not be expanded unless a concrete capability gap exists",
    "Fast mode and 1M/Max context require speed/context triggers, not generic power preference"
  ]
}
