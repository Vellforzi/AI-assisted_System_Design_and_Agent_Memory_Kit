{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-memory-kit.local/documentation-lifecycle-registry-v1.json",
  "title": "Documentation Lifecycle Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules", "navigation"],
  "properties": {
    "schema_version": {"const": "documentation-lifecycle-registry.v1"},
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "lifecycle"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "lifecycle": {"enum": ["current-source", "active-support", "historical-record", "superseded"]},
          "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "globs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "anyOf": [{"required": ["paths"]}, {"required": ["globs"]}]
      }
    },
    "navigation": {
      "type": "object", "additionalProperties": false,
      "required": ["routes", "superseded_successors", "moved_paths"],
      "properties": {
        "routes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}},
        "superseded_successors": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "successor"], "properties": {"path": {"type": "string"}, "successor": {"type": "string"}}}},
        "moved_paths": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["old", "new"], "properties": {"old": {"type": "string"}, "new": {"type": "string"}}}}
      }
    }
  }
}
